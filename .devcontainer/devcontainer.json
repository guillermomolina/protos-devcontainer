{
  "name": "Protos Development Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/protos-devcontainer",
  // Docker:
  // "runArgs": ["--userns=host"],
  // Podman rootless:
  "runArgs": ["--userns=keep-id"],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "guillermomolina.protos@0.2.2",
        "anthropic.claude-code"
      ]
    }
  },
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.claude\"",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ]
}
