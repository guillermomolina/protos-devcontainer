Range: import("std:collections/Range")

swap: (A, i, j) => {
    value: A[i]
    A[i] = A[j]
    A[j] = value
}

quickSort: (array) => {
    sortRange: (left, right) => {
        i: left
        j: right
        pivot: array[left + (right - left).div(2)]

        while(i <= j) {
            while(array[i] < pivot) {
                i = i + 1
            }

            while(array[j] > pivot) {
                j = j - 1
            }

            if(i <= j) {
                swap(array, i, j)
                i = i + 1
                j = j - 1
            }
        }

        if(left < j) {
            sortRange(left, j)
        }

        if(i < right) {
            sortRange(i, right)
        }
    }

    if(array.size() > 1) {
        sortRange(0, array.size() - 1)
    }

    array
}

array: [234, 43, 55, -2, 63, 5, 547, 6, 235]

print(array)
print(quickSort(array))