Range: import("std:collections/Range")

swap: (A, i, j) => {
    value: A[i]
    A[i] = A[j]
    A[j] = value
}

// https://en.wikipedia.org/wiki/Bubble_sort
bubbleSort: (A) => {
    n: A.size()
    swapped: false

    {
        swapped = false

        Range.each(1, n, (i) => {
            if(A[i - 1] > A[i]) {
                swap(A, i - 1, i)
                swapped = true
            }
        })
    } until(!swapped)

    A
}

array: [234, 43, 55, -2, 63, 5, 547, 6, 235]
print(array)
print(bubbleSort(array))
